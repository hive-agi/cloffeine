{:paths ["src"]

 ;; The private registry, declared here so a cold clone and CI resolve
 ;; hive-agi artifacts (hive-build) identically. Credentials come from
 ;; ~/.m2/settings.xml (server id "hive-gitea").
 :mvn/repos {"hive-gitea" {:url "https://gitea.hive-mcp.com/api/packages/hive-agi/maven"}}

 :deps {com.github.ben-manes.caffeine/caffeine {:mvn/version "3.2.4"}}
 :aliases
 {:test
  {:extra-paths ["test"]
   :extra-deps {org.clojure/clojure {:mvn/version "1.12.5"}
                org.clojure/test.check {:mvn/version "1.1.3"}
                criterium/criterium {:mvn/version "0.4.6"}
                cheshire/cheshire {:mvn/version "6.2.0"}
                com.taoensso/timbre {:mvn/version "6.8.0"}
                funcool/promesa {:mvn/version "12.0.1"}
                com.google.guava/guava-testlib {:mvn/version "33.6.0-jre"}
                io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :exec-fn cognitect.test-runner.api/test}

  ;; Release tooling. version = the repo's VERSION file, target = version.edn.
  :build
  {:deps {io.github.hive-agi/hive-build {:mvn/version "0.1.0"}}
   :ns-default hive-build.api}}}
